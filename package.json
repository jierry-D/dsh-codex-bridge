{
  "name": "dsh-codex-bridge",
  "version": "0.2.0",
  "description": "OpenAI Codex device-code sign-in and provider for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./typert": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE.md", "SECURITY.md"],
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": { "zh-CN": "OpenAI Codex 登录", "en": "OpenAI Codex Sign-in" },
      "summary": { "zh-CN": "通过 ChatGPT 设备码登录使用 Codex。", "en": "Sign in to Codex with a ChatGPT device code." },
      "category": "authentication"
    },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-api-gateway"],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/provider.js && node --check lib/remote-service.js && node --check lib/remote.js && tsdown --config tsdown.config.ts"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || >=0.2.2-rc.1 <0.2.3-0",
    "@earendil-works/pi-ai": "0.87.1 || 1.1.0 || 1.3.0 || 1.4.0 || 1.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@earendil-works/pi-ai": "1.3.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jierry-D/dsh-codex-bridge.git"
  },
  "homepage": "https://github.com/jierry-D/dsh-codex-bridge"
}
